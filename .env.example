# ===========================================
# DDI API — Environment Variables
# ===========================================
# Copiar este archivo a .env y cambiar los valores
# cp .env.example .env
#
# NUNCA commitear .env al repo
# ===========================================

# --- Base de datos ---
POSTGRES_DB=ddi
POSTGRES_USER=ddi_user
POSTGRES_PASSWORD=cambiar_en_produccion
DATABASE_URL=postgresql+asyncpg://ddi_user:cambiar_en_produccion@localhost:5432/ddi

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- JWT ---
# Generar con: openssl rand -hex 32
JWT_SECRET_KEY=GENERA_ESTO_CON_OPENSSL
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- API ---
APP_NAME=DDI API
APP_VERSION=0.1.0
DEBUG=false
CORS_ORIGINS=["http://localhost:3000"]
RATE_LIMIT_PER_MINUTE=60

# --- API Key salt ---
# Generar con: python -c "import secrets; print(secrets.token_hex(16))"
API_KEY_SALT=GENERA_ESTO_CON_PYTHON

# --- External APIs (Sprint 01) ---
NOTION_API_KEY=secret_xxx
AIRTABLE_API_KEY=patXXX
GITHUB_TOKEN=ghp_xxx

# --- MCP ---
DDI_API_KEY=ddi_xxx
