rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Public, read-only access to active links. Editing happens from the
    // Firebase console (which authenticates as a project owner and is not
    // subject to these rules), so no client write path is exposed here.
    match /links/{linkId} {
      allow read: if resource.data.active == true;
      allow write: if false;
    }

    // Write-only lead capture: anyone can submit a lead, nobody can read,
    // edit or delete them from the client. Consent must be explicit
    // (checked client-side) before the write is even attempted, and the
    // stored shape is validated here so only well-formed leads land.
    match /leads/{leadId} {
      allow read, update, delete: if false;
      allow create: if request.resource.data.keys().hasOnly(['email', 'source_utm', 'timestamp'])
        && request.resource.data.email is string
        && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && (request.resource.data.source_utm == null || request.resource.data.source_utm is string)
        && request.resource.data.timestamp == request.time;
    }
  }
}
